{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Cloudflare HTTPS Tunnel",
      "type": "shell",
      "command": "& \"C:\\Program Files (x86)\\cloudflared\\cloudflared.exe\" tunnel --url http://127.0.0.1:8080",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Local Server (server.py)",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/server.py", "-b", "0.0.0.0", "-p", "8080"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "isBackground": true
    },
    {
      "label": "Serve for Mobile / iPad",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/server.py", "-b", "0.0.0.0", "-p", "8080"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "isBackground": true
    },
    {
      "label": "Build WASM (ninja)",
      "type": "shell",
      "command": "ninja; if ($?) { python ..\\patch_wasm_html.py }",
      "options": {
        "cwd": "${workspaceFolder}/build-wasm",
        "env": {
          "EMSDK": "C:\\emsdk",
          "EM_CONFIG": "C:\\emsdk\\.emscripten",
          "PATH": "C:\\emsdk;C:\\emsdk\\upstream\\emscripten;C:\\Qt\\6.11.0\\wasm_multithread\\bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Netlify Dev",
      "type": "shell",
      "command": "npx netlify dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "isBackground": true
    }
  ]
}
